# ──────────────────────────────────────────────────────────
# Kotak Neo FastAPI Trading Bot — Environment Variables
# Copy to .env and fill real credentials. NEVER commit .env.
# ──────────────────────────────────────────────────────────

# ── OPERATION MODE ───────────────────────────────────────
# true  = simulation (safe default)
# false = LIVE trading (requires Kotak credentials below)
DRY_RUN=true
LOG_LEVEL=INFO

# Schema diagnostics (redacts secrets)
ENABLE_SCHEMA_DIAGNOSTICS=false

# ── PROTECTION VERIFICATION ──────────────────────────────
SL_MAX_RETRIES=2
VERIFY_MAX_RETRIES=3
VERIFY_INTERVAL_SEC=0.3

# ── KOTAK NEO CREDENTIALS (required for LIVE mode) ───────
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_CONSUMER_SECRET=
KOTAK_ENVIRONMENT=PROD
KOTAK_MOBILE_NUMBER=your_mobile_number
KOTAK_PASSWORD=your_trading_password
KOTAK_MPIN=your_6_digit_mpin
KOTAK_TOTP_SECRET=
KOTAK_UCC=

# ── TELEGRAM ALERTS ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_ALERTS_ENABLED=true

# ── REQUIRED FLOW PRICE OFFSETS ───────────────────────────
# Half 1 square-off SL: trigger = entry +/- SL_OFFSET, limit = entry +/- SL_LIMIT_BUFFER
# Half 2 target:        entry +/- TARGET_OFFSET
# Half 2 SL:            same SL_OFFSET / SL_LIMIT_BUFFER (OCO with target)
PROFIT_OFFSET=2.0
TARGET_OFFSET=2.0
SL_OFFSET=2.0
SL_LIMIT_BUFFER=10.0
PARTIAL_FILL_HANDLING=AGGREGATED
TICK_SIZE=0.05
NIFTY_LOT_SIZE=65

# ── EXCHANGE / PRODUCT ────────────────────────────────────
EXCHANGE_SEGMENT=nse_fo
# place_order allows only CNC / NRML / MIS / MTF (SDK v3). Used when entry omits product.
PRODUCT_TYPE=MIS
# BO/CO entries cannot be placed via SDK. Set to MIS|NRML to place protective exits
# with that product (explicit); leave empty to refuse BO and alert only.
BO_PROTECT_AS_PRODUCT=MIS
SYMBOL_FILTER_PREFIX=NIFTY

# ── WORKER TIMING ─────────────────────────────────────────
REST_BACKUP_POLL_INTERVAL_SEC=5
RECONCILIATION_INTERVAL_SEC=15
WS_RECONNECT_DELAY_SEC=2
WS_MAX_RECONNECT_ATTEMPTS=10
